# Copy to .env — NEVER commit .env to git.
# Same MySQL database as cloud_billing (shared CloudStreaming_Catalog table).

CS_DB_HOST=127.0.0.1
CS_DB_NAME=
CS_DB_USER=
CS_DB_PASS=

CS_CATALOG_LOCALE=en-PL
CS_CATALOG_REGION=PL
CS_CATALOG_SYNC_INTERVAL_SEC=3600
CS_CATALOG_HTTP_TIMEOUT_SEC=60

# Optional: NPSSO of a rental PS account — imports purchased/owned titles into catalog
CS_CATALOG_NPSSO=

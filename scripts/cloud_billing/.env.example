# Copy to .env on the billing server. NEVER commit .env to git.

# MySQL (same server as 4cloud autobilling)
CS_DB_HOST=
CS_DB_NAME=
CS_DB_USER=
CS_DB_PASS=

# Robokassa recurring (same merchant as autobilling_monitor.py)
CS_MRH_LOGIN=
CS_ROBOKASSA_PASS1=
CS_ROBOKASSA_PASS2=

# UDP listener (open this port in firewall)
CS_BILLING_UDP_HOST=0.0.0.0
CS_BILLING_UDP_PORT=13750

# Business rules
CS_RETENTION_DAYS=3
CS_RENEW_LEAD_MINUTES=10
CS_HEARTBEAT_TIMEOUT_SEC=180
CS_DEFAULT_HOURLY_PRICE=110
